{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "preview", "mixer", "settings", "langpop", "tip", "bt", "cal", "float-*", "note-*"],
  "permissions": ["core:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-is-maximized", "core:window:allow-set-size", "core:window:allow-start-resize-dragging"]
}
